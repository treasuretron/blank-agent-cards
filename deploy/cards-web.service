[Unit]
Description=Cards production frontend snapshot
After=network.target
Requires=opt-cards.mount
After=opt-cards.mount

[Service]
User=cards-web
Group=cards-web
WorkingDirectory=/var/lib/cards-web/app/web
ExecStart=/usr/local/bin/node /opt/cards/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3001
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
StateDirectory=cards-web
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/cards-web
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=768M
CPUQuota=100%
TasksMax=64
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
